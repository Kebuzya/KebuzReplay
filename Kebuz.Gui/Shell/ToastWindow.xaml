<Window x:Class="Kebuz.Gui.Shell.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kebuz.Gui.Localization"
        Title="KebuzReplay"
        Width="340"
        Height="94"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource MonoFont}"
        FontSize="{StaticResource TextSize}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource PanelBrush}">

    <Border x:Name="Frame"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource EdgeBrush}"
            BorderThickness="1"
            Cursor="Hand"
            MouseLeftButtonUp="OnClicked"
            AutomationProperties.Name="{l:T Toast.ClipSaved}">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="128"
                    Height="72"
                    Background="{StaticResource RaisedBrush}"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{StaticResource HatchBrush}" />
                    <Image Source="{Binding Shot}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Headline"
                           Text="{Binding Notice}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,5,0,0"
                           Text="{Binding Game}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{StaticResource SmallSize}"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Margin="0,6,0,0"
                           Text="{l:T Toast.ClickHint}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{StaticResource TinySize}"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
