<Window x:Class="Kebuz.Gui.Shell.DetectToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kebuz.Gui.Localization"
        Title="{l:T Toast.Detect.Window}"
        Width="360"
        Height="104"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource MonoFont}"
        FontSize="{StaticResource TextSize}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource PanelBrush}">

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource EdgeBrush}"
            BorderThickness="1">
        <StackPanel Margin="12,10">
            <TextBlock x:Name="Headline"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="DetectHeadline"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding Executable}"
                       ToolTip="{Binding Location}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="{StaticResource SmallSize}"
                       Foreground="{StaticResource MutedBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{l:T Toast.Detect.Record}"
                        Margin="0,0,6,0"
                        Click="OnAccepted"
                        AutomationProperties.AutomationId="DetectAccept"
                        AutomationProperties.Name="{Binding RecordName}"
                        Style="{StaticResource SmallAccentBracketButton}" />
                <Button Content="{l:T Toast.Detect.NotGame}"
                        Click="OnRejected"
                        AutomationProperties.AutomationId="DetectReject"
                        AutomationProperties.Name="{Binding RejectName}"
                        Style="{StaticResource SmallBracketButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
