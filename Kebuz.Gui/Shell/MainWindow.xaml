<Window x:Class="Kebuz.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Kebuz.Gui.Shell"
        xmlns:gallery="clr-namespace:Kebuz.Gui.Gallery"
        xmlns:settings="clr-namespace:Kebuz.Gui.Settings"
        xmlns:l="clr-namespace:Kebuz.Gui.Localization"
        Title="KebuzReplay"
        Width="1180"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource MonoFont}"
        FontSize="{StaticResource TextSize}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource AppBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="37"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />

        <ContextMenu x:Key="TrayContextMenu" Style="{StaticResource TrayMenu}">
            <MenuItem Header="{l:T Tray.Open}" Click="OnTrayOpen" />
            <MenuItem Header="{l:T Tray.Exit}" Click="OnTrayExit" />
        </ContextMenu>

        <Style x:Key="MaximizeCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="shell:CaptionChrome.IsMaximizeHovered" Value="True">
                    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="{StaticResource AppBrush}"
            BorderBrush="{StaticResource EdgeBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="37"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="13,0,20,0"
                                VerticalAlignment="Center">
                        <Grid Width="17" Height="17" Margin="0,0,9,0">
                            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.6" />
                            <Border Width="7"
                                    Height="7"
                                    Margin="2.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource SecondBrush}" />
                        </Grid>
                        <TextBlock Text="KebuzReplay"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource TitleSize}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="GalleryTab"
                                     Content="{l:T Shell.Gallery}"
                                     GroupName="Screens"
                                     IsChecked="True"
                                     Style="{StaticResource TabButton}"
                                     WindowChrome.IsHitTestVisibleInChrome="True" />
                        <RadioButton x:Name="SettingsTab"
                                     Content="{l:T Shell.Settings}"
                                     GroupName="Screens"
                                     Style="{StaticResource TabButton}"
                                     WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>

                    <shell:UpdateBar x:Name="UpdatePart"
                                     Grid.Column="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center" />

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource CaptionButton}"
                                Click="OnMinimize"
                                ToolTip="{l:T Shell.Minimize}"
                                AutomationProperties.Name="{l:T Shell.Minimize}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M0,0 H11"
                                  StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource MaximizeCaptionButton}"
                                Click="OnMaximize"
                                ToolTip="{l:T Shell.Maximize}"
                                AutomationProperties.Name="{l:T Shell.Maximize}">
                            <Path x:Name="MaximizeGlyph"
                                  Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                  StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseCaptionButton}"
                                Click="OnClose"
                                ToolTip="{l:T Shell.Close}"
                                AutomationProperties.Name="{l:T Shell.Close}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <gallery:GalleryView x:Name="GalleryScreen"
                                     Visibility="{Binding IsChecked, ElementName=GalleryTab, Converter={StaticResource ShowWhenTrue}}" />
                <settings:SettingsView x:Name="SettingsScreen"
                                       Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource ShowWhenTrue}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
