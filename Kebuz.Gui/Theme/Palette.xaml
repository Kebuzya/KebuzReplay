<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="AppColor">#FF050403</Color>
    <Color x:Key="PanelColor">#FF14110C</Color>
    <Color x:Key="RaisedColor">#FF1C1A15</Color>
    <Color x:Key="EdgeColor">#FF322E22</Color>
    <Color x:Key="TextColor">#FFEAE8E1</Color>
    <Color x:Key="MutedColor">#FF8A867C</Color>
    <Color x:Key="AccentColor">#FFF68C36</Color>
    <Color x:Key="SecondColor">#FF00C3CB</Color>
    <Color x:Key="SecondDimColor">#FF00737A</Color>

    <SolidColorBrush x:Key="AppBrush" Color="{StaticResource AppColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource EdgeColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SecondBrush" Color="{StaticResource SecondColor}" />
    <SolidColorBrush x:Key="SecondDimBrush" Color="{StaticResource SecondDimColor}" />
    <SolidColorBrush x:Key="VeilBrush" Color="{StaticResource PanelColor}" Opacity="0.72" />

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New, Segoe UI Symbol, Segoe UI Emoji</FontFamily>

    <sys:Double x:Key="TinySize">10</sys:Double>
    <sys:Double x:Key="SmallSize">11</sys:Double>
    <sys:Double x:Key="TextSize">12</sys:Double>
    <sys:Double x:Key="TitleSize">14</sys:Double>

    <DrawingBrush x:Key="HatchBrush"
                  TileMode="Tile"
                  Viewport="0,0,12,12"
                  ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Thickness="5">
                        <Pen.Brush>
                            <SolidColorBrush Color="{StaticResource EdgeColor}" Opacity="0.30" />
                        </Pen.Brush>
                    </Pen>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <LineGeometry StartPoint="-2,14" EndPoint="14,-2" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
