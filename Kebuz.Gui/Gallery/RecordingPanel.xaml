<UserControl x:Class="Kebuz.Gui.Gallery.RecordingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kebuz.Gui.Localization"
             xmlns:settings="clr-namespace:Kebuz.Gui.Settings"
             PreviewKeyDown="OnKey">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
    </UserControl.Resources>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource EdgeBrush}"
            BorderThickness="0,1,0,0" Padding="16,8" SnapsToDevicePixels="True">
        <StackPanel>
            <WrapPanel>
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanChange}" Margin="0,0,10,4">
                    <RadioButton Content="{l:T Recording.Auto}" IsChecked="{Binding IsAutomatic}" Style="{StaticResource OptionRadio}" />
                    <RadioButton Content="{l:T Recording.Manual}" IsChecked="{Binding IsManual}" Style="{StaticResource OptionRadio}" />
                </StackPanel>
                <Button Content="{Binding ButtonText}" Click="OnToggle" IsEnabled="{Binding CanStartStop}"
                        Margin="0,0,8,4" Style="{StaticResource BracketButton}"
                        AutomationProperties.AutomationId="RecordingToggle" AutomationProperties.Name="{Binding ButtonText}" />
                <Button Content="{l:T Recording.Parameters}" Click="OnSettings" Margin="0,0,8,4" Style="{StaticResource BracketButton}" />
                <settings:HelpButton Title="{l:T Recording.HelpTitle}" Text="{l:T Recording.Help}" />
            </WrapPanel>
            <WrapPanel Visibility="{Binding IsManual, Converter={StaticResource ShowWhenTrue}}" IsEnabled="{Binding CanChange}">
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                          DisplayMemberPath="Title" MinWidth="240" MaxWidth="440" Margin="0,0,8,4"
                          DropDownOpened="OnSources" Style="{StaticResource FilterCombo}"
                          AutomationProperties.Name="{l:T Recording.Source}" AutomationProperties.AutomationId="RecordingSource" />
                <RadioButton Content="{l:T Recording.Buffer}" IsChecked="{Binding IsBuffer}"
                             Margin="0,0,10,4" Style="{StaticResource OptionRadio}" />
                <RadioButton Content="{l:T Recording.Continuous}" IsChecked="{Binding IsContinuous}"
                             Margin="0,0,10,4" Style="{StaticResource OptionRadio}" />
                <settings:HelpButton Title="{l:T Recording.Method}" Text="{Binding MethodHelp}" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Style="{StaticResource SmallMutedText}"
                       AutomationProperties.AutomationId="RecordingControlStatus" />
            <TextBlock Text="{Binding Estimate}" Visibility="{Binding IsManual, Converter={StaticResource ShowWhenTrue}}"
                       Margin="0,4,0,0" Style="{StaticResource SmallMutedText}" />
            <StackPanel Margin="0,8,0,0" Visibility="{Binding StopConfirmation, Converter={StaticResource ShowWhenTrue}}">
                <TextBlock Text="{l:T Recording.StopQuestion}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="{l:T Recording.SaveLast}" Click="OnSaveStop" Margin="0,0,8,0" Style="{StaticResource BracketButton}" />
                    <Button Content="{l:T Recording.Discard}" Click="OnDiscard" Margin="0,0,8,0" Style="{StaticResource BracketButton}" />
                    <Button Content="{l:T Settings.Common.Cancel}" Click="OnCancel" Style="{StaticResource BracketButton}" />
                </WrapPanel>
            </StackPanel>
            <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasRecoveries, Converter={StaticResource ShowWhenTrue}}" IsEnabled="{Binding CanChange}">
                <ComboBox ItemsSource="{Binding Recoveries}" SelectedItem="{Binding SelectedRecovery}"
                          DisplayMemberPath="Folder" MaxWidth="480" Style="{StaticResource FilterCombo}"
                          AutomationProperties.Name="{l:T Recording.Unfinished}" />
                <Button Content="{l:T Recording.Recover}" Click="OnRecover" Margin="8,0,0,0" Style="{StaticResource BracketButton}" />
            </WrapPanel>
            <ScrollViewer MaxHeight="260" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowSettings, Converter={StaticResource ShowWhenTrue}}"
                          AutomationProperties.AutomationId="ManualRecordingSettings">
                <StackPanel>
                    <StackPanel IsEnabled="{Binding CanChange}" Visibility="{Binding IsManual, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Text="{l:T Recording.ManualParameters}" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{l:T Settings.Quality.Heading}" Margin="0,12,0,8" Style="{StaticResource SectionHeader}" />
                        <settings:QualitySection DataContext="{Binding Quality}" />
                        <TextBlock Text="{l:T Settings.Buffer.Heading}" Margin="0,18,0,8" Style="{StaticResource SectionHeader}" />
                        <settings:BufferSection DataContext="{Binding Buffer}" />
                        <TextBlock Text="{l:T Settings.Sound.Title}" Margin="0,18,0,8" Style="{StaticResource SectionHeader}" />
                        <settings:SoundSection DataContext="{Binding Sound}" />
                    </StackPanel>
                    <TextBlock Text="{l:T Recording.ControlHotkey}" Margin="0,18,0,8" Style="{StaticResource SectionHeader}" />
                    <settings:HotkeySection x:Name="ControlKey" DataContext="{Binding ControlHotkey}" />
                    <Button Content="{l:T Recording.ClearHotkey}" Click="OnClearHotkey" Margin="0,6,0,0"
                            HorizontalAlignment="Left" Style="{StaticResource BracketButton}" />
                    <TextBlock Text="{Binding HotkeyComplaint}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasHotkeyComplaint, Converter={StaticResource ShowWhenTrue}}" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
