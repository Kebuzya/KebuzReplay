<UserControl x:Class="Kebuz.Gui.Settings.HelpButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kebuz.Gui.Localization"
             x:Name="Root">

    <Grid>
        <ToggleButton x:Name="Toggle"
                      Width="18"
                      Height="18"
                      Cursor="Hand"
                      Focusable="True"
                      FocusVisualStyle="{x:Null}"
                      ToolTip="{l:T Settings.Help.Tooltip}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Ring"
                            Background="Transparent"
                            BorderBrush="{StaticResource EdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Glyph"
                                   Text="i"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource SmallSize}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="Sheet"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="False"
               AllowsTransparency="False">
            <Border Width="420"
                    Padding="16,14"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               Margin="0,0,0,10"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding Text, ElementName=Root}"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               FontSize="{StaticResource SmallSize}"
                               Foreground="{StaticResource TextBrush}"
                               AutomationProperties.AutomationId="HelpText" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
