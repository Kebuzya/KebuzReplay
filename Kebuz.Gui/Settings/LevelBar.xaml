<UserControl x:Class="Kebuz.Gui.Settings.LevelBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="3"
             Focusable="False"
             IsTabStop="False"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="PeakFill" TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource SecondDimBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Limiting}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BodyFill" TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource SecondBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Limiting}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource RaisedBrush}" ClipToBounds="True">
        <Rectangle Style="{StaticResource PeakFill}" RenderTransformOrigin="0,0.5">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleX="{Binding Peak}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Style="{StaticResource BodyFill}" RenderTransformOrigin="0,0.5">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleX="{Binding Body}" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
