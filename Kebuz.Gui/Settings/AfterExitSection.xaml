<settings:SectionControl x:Class="Kebuz.Gui.Settings.AfterExitSection"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:l="clr-namespace:Kebuz.Gui.Localization"
                         xmlns:settings="clr-namespace:Kebuz.Gui.Settings">

    <StackPanel>
        <CheckBox Content="{l:T Settings.Games.KeepAfterExit}"
                  IsChecked="{Binding KeepAfterExit}"
                  Margin="0,0,0,10"
                  AutomationProperties.AutomationId="KeepAfterExit"
                  Style="{StaticResource OptionCheck}" />
        <Grid IsEnabled="{Binding KeepAfterExit}" Style="{StaticResource NestedRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="166" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{l:T Settings.Games.KeepAfterExitLength}" Style="{StaticResource FieldLabel}" />
            <Slider Grid.Column="1"
                    Minimum="10"
                    Maximum="300"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    SmallChange="10"
                    LargeChange="30"
                    AutomationProperties.AutomationId="KeepAfterExitSeconds"
                    AutomationProperties.Name="{l:T Settings.Games.KeepAfterExitLengthName}"
                    ValueChanged="OnSliderChanged"
                    Value="{Binding KeepAfterExitSeconds}"
                    Style="{StaticResource SecondLineSlider}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding KeepAfterExitText}"
                       HorizontalAlignment="Right"
                       Style="{StaticResource FieldLabel}" />
        </Grid>
    </StackPanel>
</settings:SectionControl>
