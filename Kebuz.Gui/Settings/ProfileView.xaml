<UserControl x:Class="Kebuz.Gui.Settings.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Kebuz.Gui.Localization"
             xmlns:settings="clr-namespace:Kebuz.Gui.Settings"
             PreviewKeyDown="OnKeyCaptured"
             Background="{StaticResource AppBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,14,0,0">
            <Button Content="{l:T Settings.Profile.Back}"
                    HorizontalAlignment="Left"
                    Margin="20,0,0,14"
                    Click="OnBack"
                    AutomationProperties.AutomationId="ProfileBack"
                    AutomationProperties.Name="{l:T Settings.Profile.BackName}"
                    Style="{StaticResource BracketButton}" />
            <RadioButton Content="{l:T Settings.Quality.Title}"
                         IsChecked="True"
                         Checked="OnSectionPicked"
                         Tag="{Binding ElementName=ProfileQuality}"
                         Style="{StaticResource NavItem}" />
            <RadioButton Content="{l:T Settings.Buffer.Title}"
                         Checked="OnSectionPicked"
                         Tag="{Binding ElementName=ProfileBuffer}"
                         Style="{StaticResource NavItem}" />
            <RadioButton Content="{l:T Settings.Sound.Title}"
                         Checked="OnSectionPicked"
                         Tag="{Binding ElementName=ProfileSound}"
                         Style="{StaticResource NavItem}" />
            <RadioButton Content="{l:T Settings.Profile.Hotkey}"
                         Checked="OnSectionPicked"
                         Tag="{Binding ElementName=ProfileHotkey}"
                         Style="{StaticResource NavItem}" />
        </StackPanel>

        <Border Grid.Column="1" Width="1" Background="{StaticResource EdgeBrush}" />

        <ScrollViewer Grid.Column="2"
                      AutomationProperties.AutomationId="ProfileBody"
                      Style="{StaticResource ThinScrollViewer}">
            <StackPanel Margin="28,22,20,28" MaxWidth="760" HorizontalAlignment="Left">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}"
                               AutomationProperties.AutomationId="ProfileTitle"
                               Style="{StaticResource SectionHeader}" />
                    <settings:HelpButton Title="{l:T Settings.Profile.HelpTitle}"
                                         Margin="10,-2,0,0"
                                         VerticalAlignment="Top"
                                         Text="{l:T Settings.Profile.Help}" />
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}"
                           AutomationProperties.AutomationId="ProfileSummary"
                           Margin="0,0,0,4"
                           TextWrapping="Wrap"
                           Style="{StaticResource SmallMutedText}" />
                <TextBlock Text="{Binding Games.Complaint}"
                           AutomationProperties.AutomationId="ProfileComplaint"
                           Style="{StaticResource Complaint}"
                           Visibility="{Binding Games.HasComplaint, Converter={StaticResource ShowWhenTrue}}" />

                <Border Style="{StaticResource Divider}" Margin="0,22" />

                <StackPanel x:Name="ProfileQuality">
                    <TextBlock Text="{l:T Settings.Quality.Heading}" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="{l:T Settings.Profile.OwnQuality}"
                              IsChecked="{Binding OwnQuality}"
                              Margin="0,0,0,14"
                              HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="OwnQuality"
                              Style="{StaticResource OptionCheck}" />
                    <settings:QualitySection DataContext="{Binding Quality}"
                                             IsEnabled="{Binding DataContext.OwnQuality, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Style="{StaticResource ProfileGroup}" />
                </StackPanel>

                <Border Style="{StaticResource Divider}" Margin="0,26" />

                <StackPanel x:Name="ProfileBuffer">
                    <TextBlock Text="{l:T Settings.Buffer.Heading}" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="{l:T Settings.Profile.OwnBuffer}"
                              IsChecked="{Binding OwnBuffer}"
                              Margin="0,0,0,14"
                              HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="OwnBuffer"
                              Style="{StaticResource OptionCheck}" />
                    <settings:BufferSection DataContext="{Binding Buffer}"
                                            IsEnabled="{Binding DataContext.OwnBuffer, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource ProfileGroup}" />
                </StackPanel>

                <Border Style="{StaticResource Divider}" Margin="0,26" />

                <StackPanel x:Name="ProfileSound">
                    <TextBlock Text="{l:T Settings.Sound.Heading}" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="{l:T Settings.Profile.OwnSound}"
                              IsChecked="{Binding OwnSound}"
                              Margin="0,0,0,14"
                              HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="OwnSound"
                              Style="{StaticResource OptionCheck}" />
                    <settings:SoundSection DataContext="{Binding Sound}"
                                           IsEnabled="{Binding DataContext.OwnSound, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Style="{StaticResource ProfileGroup}" />
                </StackPanel>

                <Border Style="{StaticResource Divider}" Margin="0,26" />

                <StackPanel x:Name="ProfileHotkey">
                    <TextBlock Text="{l:T Settings.Profile.HotkeyHeading}" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="{l:T Settings.Profile.OwnHotkey}"
                              IsChecked="{Binding OwnHotkey}"
                              Margin="0,0,0,14"
                              HorizontalAlignment="Left"
                              AutomationProperties.AutomationId="OwnHotkey"
                              Style="{StaticResource OptionCheck}" />
                    <settings:HotkeySection x:Name="HotkeyBlock"
                                            DataContext="{Binding Hotkey}"
                                            IsEnabled="{Binding DataContext.OwnHotkey, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource ProfileGroup}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
